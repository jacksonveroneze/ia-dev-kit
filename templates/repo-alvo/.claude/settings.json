{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Read",
      "Glob",
      "Grep",
      "Bash(dotnet restore*)",
      "Bash(dotnet build*)",
      "Bash(dotnet test*)",
      "Bash(dotnet format*)",
      "Bash(dotnet sln * list)",
      "Bash(dotnet --info)",
      "Bash(dotnet --version)",
      "Bash(git status*)",
      "Bash(git diff*)",
      "Bash(git log*)",
      "Bash(git show*)",
      "Bash(git branch)",
      "Bash(git branch --list*)",
      "Bash(git branch --show-current)",
      "Bash(git branch -a*)",
      "Bash(git branch -r*)",
      "Bash(git branch -v*)",
      "Bash(git fetch*)",
      "Bash(git worktree list*)",
      "Bash(git remote get-url*)",
      "Bash(git check-ignore*)",
      "Bash(gh auth status*)",
      "Bash(gh pr view*)",
      "Bash(gh pr list*)",
      "Bash(gh pr diff*)",
      "Bash(gh pr checks*)",
      "Bash(gh issue view*)",
      "Bash(gh issue list*)",
      "Bash(gh repo view*)",
      "Bash(gh run list*)",
      "Bash(gh run view*)",
      "Bash(ls*)",
      "Bash(wc*)",
      "Bash(git rev-parse*)",
      "Bash(git ls-tree*)",
      "Bash(git rev-list*)",
      "Bash(command -v*)"
    ],
    "ask": [
      "Bash(git push*)",
      "Bash(git commit*)",
      "Bash(git merge*)",
      "Bash(git rebase*)",
      "Bash(git checkout*)",
      "Bash(git switch*)",
      "Bash(git worktree add*)",
      "Bash(git worktree remove*)",
      "Bash(gh pr create*)",
      "Bash(gh pr comment*)",
      "Bash(gh pr review*)",
      "Bash(gh pr edit*)",
      "Bash(gh pr close*)",
      "Bash(gh issue create*)",
      "Bash(gh issue comment*)",
      "Bash(gh issue edit*)",
      "Bash(gh api*)",
      "Bash(gh workflow run*)",
      "Bash(dotnet add package*)",
      "Bash(dotnet ef*)"
    ],
    "deny": [
      "Read(./.env)",
      "Read(**/.env)",
      "Read(./.env.local)",
      "Read(**/.env.local)",
      "Read(./.env.production)",
      "Read(**/.env.production)",
      "Read(./.env.development)",
      "Read(**/.env.development)",
      "Read(./.env.staging)",
      "Read(**/.env.staging)",
      "Read(./.env.test)",
      "Read(**/.env.test)",
      "Read(./.env.*.local)",
      "Read(**/.env.*.local)",
      "Read(**/*.pfx)",
      "Read(**/*.p12)",
      "Read(**/*.pem)",
      "Read(**/*.key)",
      "Read(**/secrets/**)",
      "Read(**/secrets.json)",
      "Read(**/appsettings.Production.json)",
      "Read(**/appsettings.Prod.json)",
      "Edit(./.env)",
      "Edit(**/.env)",
      "Edit(./.env.local)",
      "Edit(**/.env.local)",
      "Edit(./.env.production)",
      "Edit(**/.env.production)",
      "Edit(./.env.development)",
      "Edit(**/.env.development)",
      "Edit(./.env.staging)",
      "Edit(**/.env.staging)",
      "Edit(./.env.test)",
      "Edit(**/.env.test)",
      "Edit(./.env.*.local)",
      "Edit(**/.env.*.local)",
      "Edit(**/*.pfx)",
      "Edit(**/*.p12)",
      "Edit(**/*.pem)",
      "Edit(**/*.key)",
      "Edit(**/secrets/**)",
      "Edit(**/secrets.json)",
      "Edit(**/appsettings.Production.json)",
      "Edit(**/appsettings.Prod.json)",
      "Bash(git push --force*)",
      "Bash(git push -f*)",
      "Bash(git push * --force*)",
      "Bash(git push * -f)",
      "Bash(git push --force-with-lease*)",
      "Bash(git push * main)",
      "Bash(git push * develop)",
      "Bash(git push origin HEAD:main*)",
      "Bash(git push origin HEAD:develop*)",
      "Bash(git reset --hard*)",
      "Bash(git clean -f*)",
      "Bash(git checkout -- .)",
      "Bash(rm -rf*)",
      "Bash(gh pr merge*)",
      "Bash(git branch -D*)",
      "Bash(git branch -d*)",
      "Bash(git push * *:main*)",
      "Bash(git push * *:develop*)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Read|Edit|Write|MultiEdit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/block-sensitive-files.sh"
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/block-risky-bash.sh"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/format-dotnet.sh",
            "timeout": 60
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/notify.sh \"Claude Code terminou e aguarda voce\""
          }
        ]
      }
    ],
    "Notification": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/notify.sh \"Claude Code precisa de uma decisao ou permissao\""
          }
        ]
      }
    ]
  }
}
